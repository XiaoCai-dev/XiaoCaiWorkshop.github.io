---
import { t } from '@/i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length === 0 ? (
    <p class="text-[12px] text-faint" data-i18n="project.noSections">
      {t('project.noSections')}
    </p>
  ) : (
    <nav class="text-[13px]">
      <p class="mb-2.5 text-[11px] font-medium uppercase tracking-wider text-faint" data-i18n="project.onThisPage">
        {t('project.onThisPage')}
      </p>
      <ul class="flex flex-col gap-0.5">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-slug={h.slug}
              class:list={['toc-link block py-1 border-l', h.depth === 3 ? 'pl-6' : 'pl-3']}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-slug]'));
  if (links.length > 0) {
    const bySlug = new Map(links.map((l) => [l.getAttribute('data-toc-slug'), l]));
    const slugSet = new Set(bySlug.keys());
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>('.prose-doc h2[id], .prose-doc h3[id]'),
    ).filter((h) => slugSet.has(h.id));

    // The article column is its own scroll container in the project app-shell;
    // observe against it (fall back to the viewport elsewhere).
    const root = document.querySelector<HTMLElement>('article') ?? null;

    let active: HTMLAnchorElement | undefined;
    const setActive = (slug: string | null) => {
      if (active?.getAttribute('data-toc-slug') === slug) return;
      links.forEach((l) => l.classList.remove('active'));
      const next = slug ? bySlug.get(slug) : undefined;
      if (next) next.classList.add('active');
      active = next;
    };

    const obs = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { root, rootMargin: '-24px 0px -55% 0px', threshold: [0, 1] },
    );
    targets.forEach((h) => obs.observe(h));
  }
</script>
