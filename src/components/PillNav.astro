---
import { NAV } from '@/config';
import { t } from '@/i18n/ui';
import { u } from '@/utils/url';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
function isActive(href: string) {
  if (href.startsWith('http')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

<nav
  aria-label="Primary"
  class="inline-flex items-center gap-1 rounded-full border border-line bg-paper/80 backdrop-blur px-1 py-1 shadow-[0_1px_2px_rgba(0,0,0,0.04)]"
>
  {
    NAV.map((item) => {
      const active = isActive(item.href);
      const key =
        item.label === 'About'
          ? 'nav.about'
          : item.label === 'Projects'
            ? 'nav.projects'
            : 'nav.github';
      return (
        <a
          href={u(item.href)}
          target={'external' in item && item.external ? '_blank' : undefined}
          rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[13px] font-medium transition-colors',
            active
              ? 'bg-ink text-paper'
              : 'text-muted hover:text-ink hover:bg-line/50',
          ]}
        >
          <span data-i18n={key}>{t(key)}</span>
          {'external' in item && item.external && (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          )}
        </a>
      );
    })
  }
</nav>
